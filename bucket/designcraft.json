{
    "version": "0.5.0",
    "description": "Page layout and publishing; an open-source, clean-room reimplementation of Adobe InDesign, rebuilt in pure Rust.",
    "homepage": "https://getartcraft.com/apps/designcraft",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/designcraft/releases/download/v0.5.0/designcraft-0.5.0-windows-x64-portable.zip",
            "hash": "5656f62f634a8a259f81906597416cbbeded9c42b0e295d86cac17835eeb6f85",
            "extract_dir": "designcraft-0.5.0-windows-x64-portable"
        },
        "32bit": {
            "url": "https://github.com/storytold/designcraft/releases/download/v0.5.0/designcraft-0.5.0-windows-x86-portable.zip",
            "hash": "2e3ee5502bf498d29ae82626436341b5d31a0caa7c296d715535d19d965963d1",
            "extract_dir": "designcraft-0.5.0-windows-x86-portable"
        }
    },
    "bin": [
        "designcraft.exe",
        "designcraft-cli.exe"
    ],
    "persist": "config",
    "shortcuts": [
        [
            "designcraft.exe",
            "DesignCraft"
        ]
    ],
    "pre_install": "if (!(Test-Path \"$persist_dir\\config\")) { New-Item -ItemType Directory -Path \"$persist_dir\\config\" | Out-Null }",
    "env_set": {
        "DESIGNCRAFT_CONFIG_DIR": "$persist_dir\\config"
    },
    "notes": [
        "DesignCraft stores preferences, brush presets and recovery data outside the app directory by default (%APPDATA%\\DesignCraft). This manifest sets DESIGNCRAFT_CONFIG_DIR to the persisted 'config' directory, so settings, presets and recovery files survive updates.",
        "Launch the GUI with 'designcraft' (or the DesignCraft Start Menu entry). 'designcraft-cli' is the headless interface (run/batch/commands/mcp) and is also on PATH.",
        "Autoupdate uses the SHA256SUMS.txt published with each GitHub release."
    ],
    "checkver": {
        "github": "https://github.com/storytold/designcraft"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/designcraft/releases/download/v$version/designcraft-$version-windows-x64-portable.zip",
                "extract_dir": "designcraft-$version-windows-x64-portable"
            },
            "32bit": {
                "url": "https://github.com/storytold/designcraft/releases/download/v$version/designcraft-$version-windows-x86-portable.zip",
                "extract_dir": "designcraft-$version-windows-x86-portable"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt",
            "find": "$basename"
        }
    }
}
